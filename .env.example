# Node Environment (development | production)
NODE_ENV=

# Port for the server to listen on (e.g., 5000)
PORT=

# PostgreSQL Database Connection String (e.g., Neon Postgres)
DATABASE_URL=

# JWT Secrets and Lifespans
JWT_SECRET=
JWT_EXPIRES_IN=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=

# Frontend Application Origin (CORS and redirects)
FRONTEND_URL=

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis Configuration (Optional, for BullMQ)
REDIS_ENABLED=
REDIS_URL=

# OpenAI API Key for Generative AI Features
OPENAI_API_KEY=

# Meta / Instagram OAuth Credentials (for future creator sync)
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=

# Cookie Settings for Authentication Session
COOKIE_DOMAIN=
COOKIE_SECURE=
