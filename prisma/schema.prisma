generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                @id @default(uuid())
  email                   String                @unique
  passwordHash            String
  role                    Role                  @default(USER)
  credits                 Int                   @default(5)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  instagramAccessToken    String?
  instagramConnectedAt    DateTime?
  instagramUserId         String?
  instagramUsername       String?
  instagramOAuthState     String?
  instagramTokenExpiresAt DateTime?
  instagramTokenType      String?
  aiAnalysisCount         Int                   @default(0)
  aiTokensUsed            Int                   @default(0)
  aiJobs                  AIJob[]
  brolls                  BRoll[]
  collabs                 Collab[]
  creatorIntelligences    CreatorIntelligence[]
  creatorOpportunities    CreatorOpportunity[]
  creatorProfile          CreatorProfile?
  dumps                   Dump[]
  hookLibraries           HookLibrary[]
  instagramAiAnalyses     InstagramAIAnalysis[]
  instagramSnapshots      InstagramSnapshot[]
  journalEntries          JournalEntry[]
  notifications           Notification[]
  posts                   Post[]
  reelBreakdowns          ReelBreakdown[]
  shoots                  Shoot[]
  publishingJobs          PublishingJob[]

  @@index([email])
}

model Post {
  id        String     @id @default(uuid())
  title     String
  date      String
  type      PostType   @default(REEL)
  status    PostStatus @default(DRAFT)
  mood      String
  caption   String?
  hashtags  String?
  notes     String?
  shootId   String?    @unique
  userId            String
  publishAt         DateTime?
  scheduledAt       DateTime?
  scheduledByUserId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  shoot     Shoot?     @relation(fields: [shootId], references: [id])
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  brolls         BRoll[]
  publishingJobs PublishingJob[]

  @@index([userId, date])
}

model Dump {
  id        String   @id @default(uuid())
  title     String
  text      String
  mood      String
  ts        String
  archived  Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, archived])
}

model Shoot {
  id        String   @id @default(uuid())
  name      String
  shootDate String
  slotsJson String
  postId    String?  @unique
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, shootDate])
}

model Collab {
  id               String        @id @default(uuid())
  brand            String
  contactName      String?
  email            String?
  platform         String        @default("Instagram")
  status           CollabStatus  @default(DREAM_BRAND)
  quote            Int           @default(0)
  negotiatedAmount Int           @default(0)
  dueDate          String?
  paymentStatus    PaymentStatus @default(UNPAID)
  notes            String?
  pitchDraft       String?
  followUpDraft    String?
  scriptText       String?
  wardrobe         String?
  props            String?
  briefFileName    String?
  briefFileUrl     String?
  userId           String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliverables     Deliverable[]

  @@index([userId, status])
}

model Deliverable {
  id        String   @id @default(uuid())
  text      String
  type      String
  postId    String?
  shootId   String?
  completed Boolean  @default(false)
  collabId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  collab    Collab   @relation(fields: [collabId], references: [id], onDelete: Cascade)

  @@index([collabId])
}

model ReelBreakdown {
  id           String   @id @default(uuid())
  url          String
  insightsJson String
  stepsJson    String
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, url])
}

model AIJob {
  id         String   @id @default(uuid())
  queueName  String
  status     String
  resultJson String?
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Notification {
  id        String   @id @default(uuid())
  text      String
  read      Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model BRoll {
  id           String   @id @default(uuid())
  title        String
  description  String
  mood         String
  visualTags   String
  emotionTags  String
  location     String?
  lighting     String?
  motionType   String?
  audioFeeling String?
  timeOfDay    String?
  weather      String?
  clipType     String   @default("video")
  cinematicUse String?
  energy       String   @default("soft")
  notes        String?
  fileUrl      String?
  status       AssetStatus @default(DRAFT)
  duration     Int?
  fileSize     Int?
  resolution   String?
  mimeType     String?
  thumbnailUrl String?
  favorite     Boolean  @default(false)
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts        Post[]

  @@index([userId, mood])
}

model JournalEntry {
  id         String   @id @default(uuid())
  weekStart  String
  mood       String
  followers  Int      @default(0)
  posts      Int      @default(0)
  reach      Int      @default(0)
  saves      Int      @default(0)
  engagement String   @default("0")
  reflection String
  wins       String
  lessons    String
  notes      String?
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStart])
}

model InstagramSnapshot {
  id            String   @id @default(uuid())
  userId        String
  profileJson   String
  mediaJson     String
  analyticsJson String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CreatorProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  primaryNiche      String
  secondaryNiches   Json
  primaryGoal       String
  audienceSize      String
  creatorStage      String
  postingFrequency  String
  preferredFormats  Json
  contentPillars    Json
  toneOfVoice       String
  biggestChallenge  String
  aiAssistanceLevel String
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InstagramAIAnalysis {
  id            String   @id @default(uuid())
  userId        String
  mediaId       String
  caption       String?
  mediaType     String
  timestamp     DateTime
  hook          String?
  topic         String?
  contentPillar String?
  tone          String?
  ctaType       String?
  summary       String?
  aiVersion     String?
  analyzedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, mediaId])
}

model CreatorIntelligence {
  id              String   @id @default(uuid())
  userId          String
  primaryNiche    String?
  secondaryNiches Json?
  toneOfVoice     String?
  contentPillars  Json?
  creatorStage    String?
  postingStyle    String?
  sourcePostCount Int      @default(0)
  confidenceScore Float    @default(0)
  generatedAt     DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CreatorOpportunity {
  id          String   @id @default(uuid())
  userId      String
  type        String
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HookLibrary {
  id            String   @id @default(uuid())
  userId        String
  hookText      String
  hookCategory  String
  frequency     Int      @default(1)
  examplePostId String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

enum PostType {
  REEL
  IMAGE
  CAROUSEL
  STORY
  NOTE
}

enum AssetStatus {
  DRAFT
  READY
  ATTACHED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum PostStatus {
  DRAFT
  REVIEW
  APPROVED
  MEDIA_READY
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  POSTED
  ARCHIVED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CollabStatus {
  DREAM_BRAND @map("dream brand")
  REACHED_OUT @map("reached out")
  REPLIED     @map("replied")
  DISCUSSING  @map("discussing")
  BOOKED      @map("booked")
  COMPLETED   @map("completed")
  GHOSTED     @map("ghosted 😭")
}

enum PaymentStatus {
  UNPAID
  INVOICE_SENT @map("invoice sent")
  PAID
}

model PublishingJob {
  id               String   @id @default(uuid())
  postId           String
  userId           String
  publishAt        DateTime
  status           JobStatus @default(PENDING)
  attempts         Int       @default(0)
  lastError        String?
  instagramMediaId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([publishAt])
}
